            "uid": "prometheus"
          },
          "expr": "sum(rate(pg_stat_database_xact_rollback{env=\"$env\",node=\"$node\",datname=\"$db\"}[15s]))",
          "legendFormat": "__auto",
          "refId": "A"
        }
      ],
      "title": "Rollbacks / s",
      "type": "timeseries"
    },
    {
