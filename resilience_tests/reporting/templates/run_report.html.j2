<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<title>{{ v.scenario.id }} {{ v.status }} -- {{ v.run_id }}</title>
{% include "_style.html.j2" %}
</head><body>

<h1>{{ v.scenario.id }} &middot; {{ v.scenario.name }}
  <span class="badge status s-{{ v.status }}">{{ v.status | upper | replace("_", " ") }}</span></h1>
<div class="muted mono">run {{ v.run_id }}</div>
<div class="grid" style="margin-top:10px">
  <div><b>Priority</b> {{ v.scenario.priority }} &middot; {{ v.scenario.category }}</div>
  <div><b>Environment</b> {{ v.environment.get("profile", "?") }} ({{ v.environment.get("class", "?") }})</div>
  <div><b>Target</b> {{ v.target.get("node", "?") }} ({{ v.target.get("role", "?") }})</div>
  <div><b>Duration</b> {{ v.duration or "?" }} s</div>
</div>

{% for n in v.notes %}<div class="banner note">{{ n }}</div>{% endfor %}
{% if not v.has_verdict and v.status != "stopped_before_fault" %}
<div class="banner err"><b>No verdict.</b> This run {{ v.status | replace("_", " ") }}{% if v.stopped_phase %} in phase <b>{{ v.stopped_phase }}</b>{% endif %}:
  {{ v.error or "no reason recorded" }}. It certifies nothing and is never counted as a pass.</div>
{% elif v.status == "stopped_before_fault" %}
<div class="banner note">Dry run: stopped before the fault. No verdict.</div>
{% elif v.status == "failed" %}
<div class="banner err"><b>{{ v.rules_failed }} of {{ v.rules | length }} acceptance rules did not pass.</b>{% if v.error %} {{ v.error }}{% endif %}</div>
{% endif %}

<h2>Acceptance (as evaluated by the run)</h2>
{% if v.rules %}
<table><tr><th>Rule</th><th>Outcome</th><th>Measured</th><th>Margin</th><th>Reason</th></tr>
{% for r in v.rules %}
<tr><td class="mono">{{ r.predicate }}</td>
  <td><span class="badge o-{{ r.outcome }}">{{ r.outcome | replace("_", " ") }}</span></td>
  <td>{% for x in r["values"] %}<div><span class="mono">{{ x.name }}</span> =
      {% if x.kind in ("not_measured", "not_applicable", "missing") %}<span class="badge k-{{ x.kind }}">{{ x.display }}</span>
      {% else %}<b class="mono">{{ x.display }}</b>{% endif %}</div>{% endfor %}</td>
  <td class="mono">{{ r.margin if r.margin is not none else "" }}</td>
  <td>{{ r.reason or "" }}</td></tr>
{% endfor %}
</table>
{% else %}<p class="muted">No acceptance rules were evaluated: this run has no verdict.</p>{% endif %}

<h2>Annotated timeline</h2>
{% if v.charts %}
{% for ch in v.charts %}
<div class="chart"><div><b>{{ ch.title }}</b>
  {% for s in ch.series if s.downsampled %}<span class="muted"> &middot; {{ s.name }} downsampled</span>{% endfor %}</div>
  <svg viewBox="-56 -14 {{ ch.width + 64 }} {{ ch.height + 32 }}" role="img" aria-label="{{ ch.title }}">
    {% for t in ch.yticks %}<line x1="0" y1="{{ t.y }}" x2="{{ ch.width }}" y2="{{ t.y }}" stroke="#e5e7eb"/>
      <text x="-6" y="{{ t.y + 3 }}" font-size="10" text-anchor="end" fill="#6b7280">{{ t.label }}</text>{% endfor %}
    <line x1="0" y1="0" x2="0" y2="{{ ch.height }}" stroke="#9ca3af"/>
    <line x1="0" y1="{{ ch.height }}" x2="{{ ch.width }}" y2="{{ ch.height }}" stroke="#9ca3af"/>
    {% for t in ch.ticks %}<line x1="{{ t.x }}" y1="{{ ch.height }}" x2="{{ t.x }}" y2="{{ ch.height + 4 }}" stroke="#9ca3af"/>
      <text x="{{ t.x }}" y="{{ ch.height + 15 }}" font-size="10" text-anchor="middle" fill="#6b7280">{{ t.label }}</text>{% endfor %}
    {% for m in ch.markers %}<line x1="{{ m.x }}" y1="0" x2="{{ m.x }}" y2="{{ ch.height }}"
      stroke="{{ '#dc2626' if m.kind == 'fault' else '#16a34a' }}"
      stroke-dasharray="{{ '0' if m.kind == 'fault' else '4,3' }}" stroke-width="1.2"><title>{{ m.label }}</title></line>{% endfor %}
    {% for s in ch.series %}<polyline fill="none" stroke="{{ s.color }}" stroke-width="1.3" points="{{ s.svg_points }}"/>{% endfor %}
  </svg>
  <div class="legend">{% for s in ch.series %}<span><i style="background:{{ s.color }}"></i>{{ s.name }}</span>{% endfor %}
    <span><i style="background:#dc2626"></i>fault (kill)</span><span><i style="background:#16a34a"></i>first write accepted (recovered)</span>
    <span class="muted">time axis: seconds since the run started &middot; hover a vertical line for its label</span></div>
</div>
{% endfor %}
{% endif %}
{% if v.timeline %}
<table><tr><th style="width:90px">t (s)</th><th style="width:70px">cycle</th><th>event</th></tr>
{% for m in v.timeline %}
<tr><td class="mono">{{ m.t_s }}</td><td>{{ m.cycle if m.cycle is not none else "" }}</td>
  <td class="m-{{ m.kind }}">{{ m.label }}</td></tr>
{% endfor %}</table>
{% else %}<p class="muted">No timeline: no events were recorded.</p>{% endif %}

{% if v.cycle_rows %}
<h2>Per cycle</h2>
<table><tr>{% for c in v.cycle_columns %}<th>{{ c }}</th>{% endfor %}</tr>
{% for row in v.cycle_rows %}<tr>{% for cell in row %}<td class="mono">{{ cell }}</td>{% endfor %}</tr>{% endfor %}
</table>{% endif %}

{% if v.during or v.during_verification %}
<h2>Operation the fault landed inside</h2>
{% if v.during %}<pre>{{ v.during | tojson(indent=2) }}</pre>{% endif %}
{% if v.during_verification %}<div class="muted">After recovery:</div><pre>{{ v.during_verification | tojson(indent=2) }}</pre>{% endif %}
{% endif %}

<h2>Measures</h2>
<table><tr><th>Measure</th><th>Value</th><th>Why not measured</th></tr>
{% for m in v.measures %}
<tr><td class="mono">{{ m.name }}</td>
  <td>{% if m.kind in ("not_measured", "not_applicable", "missing") %}<span class="badge k-{{ m.kind }}">{{ m.display }}</span>{% else %}<span class="mono">{{ m.display }}</span>{% endif %}</td>
  <td>{{ m.reason or "" }}</td></tr>
{% endfor %}</table>

<h2>Phases</h2>
<table><tr><th>Phase</th><th>Outcome</th><th>Duration (s)</th><th>Error</th></tr>
{% for p in v.phases %}<tr><td>{{ p.phase }}</td><td>{{ p.outcome }}</td><td class="mono">{{ p.duration_s }}</td><td>{{ p.error or "" }}</td></tr>{% endfor %}
</table>

<h2>Disclosures (what this environment and run could not prove)</h2>
{% if v.disclosures %}<ul class="disc">{% for d in v.disclosures %}<li>{{ d }}</li>{% endfor %}</ul>
{% else %}<p class="muted">None recorded.</p>{% endif %}

<h2>Evidence files</h2>
<ul>{% for f in v.files %}<li><a href="{{ f }}">{{ f }}</a></li>{% endfor %}</ul>

<footer>Generated {{ v.generated_at }} from this run's own evidence (results.json, events.jsonl).
The status and every rule outcome are shown exactly as the run recorded them.</footer>
</body></html>
